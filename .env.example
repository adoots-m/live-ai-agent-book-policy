# --- required -------------------------------------------------------------
# Google AI Studio key (https://aistudio.google.com/apikey). Used for Gemini Live
# (voice + camera), the spine/object reader, item consolidation and the pricing
# search agent (Gemini + Google Search grounding).
GOOGLE_API_KEY=replace-me

# --- policyholder locale (can also be changed by voice or in the UI) -------
LCA_COUNTRY=US
# Lines above these values are not auto-priced; they go to human appraisal.
APPRAISAL_THRESHOLD_USD=250
APPRAISAL_THRESHOLD_GBP=200

# --- metric scale -----------------------------------------------------------
# Side of the printed ArUco marker's black square, measured with a ruler.
LCA_MARKER_SIDE_CM=15.0
# Horizontal field of view of your phone's main camera at the streamed aspect.
# Calibrate once: python -m library_claim.cli calibrate-fov photo.jpg --distance-cm 100
LCA_CAMERA_HFOV_DEG=67.0

# --- models (defaults shown) -------------------------------------------------
# LCA_LIVE_MODEL=gemini-3.8-live
# LCA_VISION_MODEL=gemini-3.8-flash
# LCA_PRICING_MODEL=gemini-3.8-flash
# LCA_VOICE=Kore
# LCA_THINKING_LEVEL=low            # minimal|low|medium|high for background calls
# LCA_DEPTH_MODEL=depth-anything/Depth-Anything-V2-Metric-Indoor-Small-hf

# --- tuning --------------------------------------------------------------------
# LCA_VISION_TILES=1                # 2 = read each keyframe as two overlapping halves (more spines, 2x cost)
# LCA_EDGE_REFINE=1                 # snap spine boxes to image edges before measuring
# LCA_VISION_CONCURRENCY=4
# LCA_PRICING_CONCURRENCY=6
# LCA_DATA_DIR=./sweeps
# LCA_ACCESS_TOKEN=                 # fixed access key for the phone URL (random if unset)

# --- spend guards ---------------------------------------------------------------
# Pricing searches stop (lines go to the review queue) once this sweep's estimated spend passes the cap.
LCA_MAX_USD_PER_SWEEP=8
LCA_MAX_VISION_CALLS=250

# --- cost report rates (USD; Gemini API paid tier as published 2026-10-11) -----
# gemini-3.8-flash: $0.75 in / $3.75 out per 1M tokens until 2026-12-31 ($1.50 / $7.50 from 2027-01-01)
# LCA_PRICE_IN_PER_M=0.75
# LCA_PRICE_OUT_PER_M=3.75
# Grounding with Google Search: 5,000 requests/month free, then $14 per 1,000
# LCA_SEARCH_PRICE_PER_CALL=0.014
# gemini-3.8-live: audio in $0.005/min, video in $0.002/min, audio out $0.018/min (fallback estimate)
# LCA_LIVE_PRICE_PER_MIN=0.025
# LCA_LIVE_IN_AUDIO_PER_M=3.00
# LCA_LIVE_IN_VIDEO_PER_M=1.00
# LCA_LIVE_OUT_AUDIO_PER_M=12.00
